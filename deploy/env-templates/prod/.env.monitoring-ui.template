# Monitoring UI production configuration.
# Loaded after .env.shared / .env.prod.

# Runtime
# Compose sets UI_HOST=0.0.0.0 and UI_PORT=8090 inside the container.
UI_PORT=8090

# Frontend API access
UI_API_BASE_URL=/api

# Refresh behavior
UI_REFRESH_INTERVAL_SECONDS=15
UI_PROVIDER_REFRESH_INTERVAL_SECONDS=10
UI_ALERTS_REFRESH_INTERVAL_SECONDS=20

# Query behavior
UI_QUERY_TIMEOUT_SECONDS=5
UI_STALE_DATA_TTL_SECONDS=220
UI_DEFAULT_TIME_WINDOW=1h
UI_EXPORT_MAX_ROWS=500
