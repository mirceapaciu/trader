# Monitoring UI local configuration.
# Load .env.shared first, then this file.

# Runtime
UI_PORT=8090

# Frontend API access
UI_API_BASE_URL=http://127.0.0.1:8090/api

# Refresh behavior
UI_REFRESH_INTERVAL_SECONDS=15
UI_PROVIDER_REFRESH_INTERVAL_SECONDS=10
UI_ALERTS_REFRESH_INTERVAL_SECONDS=20

# Query behavior
UI_QUERY_TIMEOUT_SECONDS=5
UI_STALE_DATA_TTL_SECONDS=120
UI_DEFAULT_TIME_WINDOW=1h
UI_EXPORT_MAX_ROWS=500
