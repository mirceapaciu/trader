# NewsFetcher local configuration.
# Load .env.shared first, then this file.

NEWSFETCHER_DB_SCHEMA=news_fetcher

# Source toggles
# Set to true/false to enable or disable each provider.
NEWS_SOURCE_FINNHUB_ENABLED=true
NEWS_SOURCE_MARKETAUX_ENABLED=true
NEWS_SOURCE_RSS_ENABLED=true

# News providers
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
RSS_FEED_URLS=https://www.marketwatch.com/rss/topstories,https://www.marketwatch.com/rss/marketpulse

# Relevance filtering
NEWS_INCLUDE_KEYWORDS=earnings,guidance,outlook,forecast,revenue,sales,profit,profits,margin,margins,eps,beat estimates,miss estimates,upgrade,downgrade,price target,rating,analyst,merger,acquisition,takeover,buyout,deal,partnership,contract,order backlog,product launch,approval,fda approval,clinical trial,patent,lawsuit,investigation,probe,settlement,fine,recall,cyberattack,data breach,layoffs,restructuring,bankruptcy,default,debt,credit rating,dividend,buyback,share repurchase,capital raise,offering,ipo,spin off,supply shortage,demand slowdown,demand surge,tariff,sanctions,export controls,inflation,cpi,ppi,jobs report,payrolls,unemployment,interest rates,rate hike,rate cut,federal reserve,fed,yields,treasury yields,dollar,oil prices,crude,geopolitical,recession,soft landing,consumer confidence

# Scheduling
NEWS_POLL_INTERVAL=120
RSS_POLL_INTERVAL=300
MARKETAUX_POLL_INTERVAL=300
RSS_RATE_LIMIT_BACKOFF_SECONDS=900
