# ThesisBuilder local configuration.
# Load .env.shared first, then this file.

THESIS_BUILDER_DB_SCHEMA=thesis_builder

# LLM provider
LLM_MODEL=gpt-4o-mini
LLM_DAILY_TOKEN_BUDGET=5000000
LLM_FALLBACK_PROVIDER=groq
# Per-request timeout (seconds) and retry count for OpenAI calls. The consumer
# is single-threaded, so a request without a timeout silently blocks the whole
# news loop. With a timeout, a stuck request fails and the message retries/DLQs.
THESIS_BUILDER_LLM_REQUEST_TIMEOUT_SECONDS=60
THESIS_BUILDER_LLM_MAX_RETRIES=2

# Thesis-card policy
THESIS_BUILDER_DEFAULT_TIME_HORIZON=swing_1d_5d
THESIS_BUILDER_ENABLE_TREND_FOLLOW_EXTENSION=true
THESIS_BUILDER_TREND_FOLLOW_MAX_DAYS=20
THESIS_BUILDER_INITIAL_REVIEW_POLICY=preapproved
THESIS_BUILDER_EVIDENCE_COLLECTION_MAX_MINUTES=1000
THESIS_BUILDER_MIN_CONFIDENCE=0.6
# Minimum LLM relevance score for an article to count toward a thesis card.
# Off-topic articles are rejected with reason_code below_min_relevance /
# instrument_not_subject instead of feeding the card.
THESIS_BUILDER_MIN_RELEVANCE=0.5
THESIS_BUILDER_RISK_MAX_LOSS_USD=120
# Must stay coherent with TradeExecutor MAX_POSITION_SIZE and ATR_STOP_MULT.
THESIS_BUILDER_TRADEABILITY_MAX_ENTRY_PRICE=1000
THESIS_BUILDER_TRADEABILITY_ATR_STOP_MULT=1.5

# Pipeline scheduling
PIPELINE_INTERVAL=120

# Reclaim pending stream entries left behind by a dead/previous consumer after
# they have been idle this many seconds. Prevents orphaned entries in the
# consumer-group PEL from pinning pending_count and tripping the stall alarm.
# Keep well above normal per-message processing time. 0 disables reclaim.
THESIS_BUILDER_CLAIM_MIN_IDLE_SECONDS=300

# Market data / IBKR quotes
# Retrieval chain for market context: DB cache -> IBKR (live/delayed quote) ->
# Polygon previous-close fallback. Polygon key falls back to MASSIVE_API_KEY
# from .env.secrets — nothing to add here.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_MARKET_DATA_CLIENT_ID=2
MARKET_DATA_ALLOW_DELAYED=true
MARKET_DATA_QUOTE_MAX_AGE_SECONDS=1200
# Cooldown before re-attempting a refresh whose providers just failed (a stale
# snapshot with a recent as_of means "we just tried"); keeps the single-threaded
# consumer loop from re-fetching on every message.
MARKET_DATA_CONTEXT_MAX_AGE_SECONDS=300
MARKET_DATA_IBKR_QUOTE_TIMEOUT_SECONDS=10
# false also disables IBKR quotes (the gateway is not built at all).
MARKET_DATA_PREFER_IBKR_HISTORICAL=true
