# Shared cross-component configuration for local development.
# Do not commit real secrets.

# Database (PostgreSQL)
DB_BACKEND=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=trader
POSTGRES_USER=trader
POSTGRES_PASSWORD=change_me
POSTGRES_SSLMODE=disable
POSTGRES_POOL_SIZE=10
SHARED_DB_SCHEMA=shared
WATCHLIST_TABLE=t_watchlist_tickers

# Queue (Redis Streams default)
QUEUE_BACKEND=redis_streams
QUEUE_URL=redis://127.0.0.1:6379/0
NEWS_RAW_QUEUE=news_raw_queue
SIGNAL_QUEUE=signal_queue
FAILED_MESSAGES_DLQ=failed_messages_dlq
QUEUE_MAX_RETRIES=3

# Operational
LOG_LEVEL=INFO
PAPER_TRADING=true

# Product constraint: no thesis card, no trade
THESIS_CARD_ENFORCEMENT=true
THESIS_CARD_REQUIRED_EVIDENCE_COUNT=3
THESIS_CARD_MAX_AGE_MINUTES=360
